<UserControl x:Class="ForeverDB.Companion.Controls.MapPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="MapTitleText"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Text="Map" />
                <TextBlock x:Name="AssetStatusText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="Loading WoW client map..." />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="MarkersButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,6,0"
                        Click="MarkersButton_Click"
                        Content="Markers" />
                <Button x:Name="ClustersButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,6,0"
                        Click="ClustersButton_Click"
                        Content="Clusters" />
                <Button x:Name="HeatmapButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="HeatmapButton_Click"
                        Content="Heatmap" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Click="FitButton_Click"
                        Content="Fit" />
                <TextBlock x:Name="ZoomText"
                           Width="52"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextAlignment="Right"
                           Text="100%" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#0F1822"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                ClipToBounds="True">
            <ScrollViewer x:Name="MapScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="MapScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="MapScrollViewer_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="MapScrollViewer_PreviewMouseMove">
                <Grid x:Name="ZoomHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="MapScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Grid.LayoutTransform>

                    <Grid x:Name="MapSurface"
                          Width="1000"
                          Height="700"
                          Background="#0F1822">
                        <Image x:Name="MapImage"
                               Stretch="Fill"
                               SnapsToDevicePixels="True" />

                        <Canvas x:Name="FallbackGridCanvas"
                                IsHitTestVisible="False" />

                        <Canvas x:Name="HeatmapCanvas"
                                IsHitTestVisible="False" />

                        <Canvas x:Name="MarkerCanvas" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
