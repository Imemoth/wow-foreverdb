<Window x:Class="ForeverDB.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForeverDB Companion"
        Width="780"
        Height="520"
        MinWidth="680"
        MinHeight="440"
        Closing="Window_Closing">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Status">
                <StackPanel Margin="16">
                    <TextBlock Text="ForeverDB Companion"
                               FontSize="26"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,22"
                               Text="Addon sync + ForeverDB search" />

                    <TextBlock Text="Sync status"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,6,0,18"
                               Text="Starting..." />

                    <Button Width="160"
                            HorizontalAlignment="Left"
                            Click="SyncNow_Click"
                            Content="Sync now" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Search">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Width="90"
                                Margin="8,0,0,0"
                                Click="Search_Click"
                                Content="Search" />
                        <TextBox x:Name="SearchBox"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown" />
                    </DockPanel>

                    <ListBox x:Name="SearchResults"
                             Grid.Row="1"
                             Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="16">
                    <TextBlock Text="WoW Forever root" />
                    <TextBox x:Name="WowRootBox"
                             Margin="0,4,0,12" />

                    <TextBlock Text="Supabase project URL" />
                    <TextBox x:Name="SupabaseUrlBox"
                             Margin="0,4,0,12" />

                    <TextBlock Text="Supabase publishable / anon key" />
                    <TextBox x:Name="SupabaseKeyBox"
                             Margin="0,4,0,12" />

                    <CheckBox x:Name="AutoSyncCheck"
                              Margin="0,4"
                              Content="Automatically sync after /reload, logout or exit" />

                    <CheckBox x:Name="LaunchWithWindowsCheck"
                              Margin="0,4"
                              Content="Launch ForeverDB Companion with Windows" />

                    <CheckBox x:Name="StartMinimizedCheck"
                              Margin="0,4,0,14"
                              Content="Start minimized to system tray" />

                    <Button Width="120"
                            HorizontalAlignment="Left"
                            Click="SaveSettings_Click"
                            Content="Save settings" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
