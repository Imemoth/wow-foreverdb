<Window x:Class="ForeverDB.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForeverDB Companion 0.3.0-alpha"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10151E"
                BorderBrush="#2A3242"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="FDB"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="ForeverDB Companion"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Community loot intelligence for WoW Forever"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="12,7"
                        CornerRadius="14"
                        Background="#16271F"
                        BorderBrush="#2F6C51"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Companion active"
                                   Foreground="#BDEBD4"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="18,10,18,18">
            <TabItem Header="STATUS">
                <Grid Margin="8,16,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Database sync"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="ForeverDB watches your SavedVariables and uploads fresh observations automatically."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,16" />
                                <TextBlock Text="Current status"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="StatusText"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Starting..." />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="150"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Click="SyncNow_Click"
                                    Content="Sync now" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="AUTO SYNC"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock Text="Enabled"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock Text="/reload, logout and client exit"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="LOCAL DATA"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock Text="SavedVariables"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock Text="Addon database remains available in-game"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="CENTRAL DB"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock Text="Supabase"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock Text="Authenticated community snapshots"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="SEARCH">
                <Grid Margin="8,16,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="110"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Click="Search_Click"
                                    Content="Search" />
                            <TextBox x:Name="SearchBox"
                                     Height="40"
                                     FontSize="14"
                                     ToolTip="Search item, creature, object or ID"
                                     KeyDown="SearchBox_KeyDown" />
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="SearchStatusText"
                               Grid.Row="1"
                               Margin="4,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Type an item or source name and press Search." />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="RESULTS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="4,2,4,10" />
                                <ListBox x:Name="SearchResults"
                                         SelectionChanged="SearchResults_SelectionChanged" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="DetailTitleText"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Text="Select a result" />

                                <TextBlock x:Name="DetailSubtitleText"
                                           Grid.Row="1"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Item and source details will appear here." />

                                <TabControl x:Name="DetailTabs"
                                            Grid.Row="3" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS">
                <Grid Margin="8,16,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="General"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Startup and automatic synchronization"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,20" />

                            <CheckBox x:Name="AutoSyncCheck"
                                      Margin="0,5"
                                      Content="Automatically sync after /reload, logout or exit" />

                            <CheckBox x:Name="LaunchWithWindowsCheck"
                                      Margin="0,8,0,5"
                                      Content="Launch ForeverDB Companion with Windows" />

                            <CheckBox x:Name="StartMinimizedCheck"
                                      Margin="0,8,0,18"
                                      Content="Start minimized when launched with Windows" />

                            <Button Width="140"
                                    HorizontalAlignment="Left"
                                    Click="SaveSettings_Click"
                                    Content="Save settings" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Connection"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Detected game path and ForeverDB backend"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,20" />

                            <TextBlock Text="WoW Forever root"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="WowRootBox"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Supabase project URL"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="SupabaseUrlBox"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Supabase publishable key"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="SupabaseKeyBox"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
