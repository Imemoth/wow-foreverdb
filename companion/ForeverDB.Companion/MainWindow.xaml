<Window x:Class="ForeverDB.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ForeverDB Companion 0.9.0-alpha"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0A0D12"
                BorderBrush="#242B38"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="ForeverDB Companion"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="  •  0.9.0-alpha"
                               Foreground="#677387"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Click="MinimizeButton_Click"
                            Content="—" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Click="MaximizeButton_Click"
                            Content="□" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Tag="Close"
                            Click="CloseButton_Click"
                            Content="×" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#10151E"
                BorderBrush="#2A3242"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="FDB"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ForeverDB"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="23"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="  COMPANION"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock Text="Community loot intelligence for WoW Forever"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="12,7"
                        CornerRadius="14"
                        Background="#16271F"
                        BorderBrush="#2F6C51"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Companion active"
                                   Foreground="#BDEBD4"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="2"
                    Margin="18,10,18,18">
            <TabItem Header="STATUS">
                <Grid Margin="8,16,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Database sync"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Auto Sync uploads SavedVariables after /reload, logout or exit. Sync now uploads the latest snapshot already written to disk."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,16" />
                                <TextBlock Text="Current status"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="StatusText"
                                           Margin="0,4,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Starting..." />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Width="180"
                                        VerticalAlignment="Center">
                                <Button Height="40"
                                        Click="SyncNow_Click"
                                        Content="Sync now"
                                        ToolTip="Fresh in-game observations reach SavedVariables when WoW writes the file on /reload, logout or exit." />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="Uploads the latest saved snapshot" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="AUTO SYNC"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock x:Name="AutoSyncHealthText"
                                           Text="Checking..."
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock x:Name="WatcherHealthText"
                                           Text="Watcher pending"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="LAST SUCCESS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock x:Name="LastSyncHealthText"
                                           Text="No successful sync yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock x:Name="LastSyncCountsText"
                                           Text="Sources — · Guild members —"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="CENTRAL DB"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock x:Name="CentralDbHealthText"
                                           Text="Checking..."
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,4" />
                                <TextBlock Text="Supabase / anonymous auth"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="LAST ERROR"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,14,0,3" />
                                <TextBlock x:Name="LastErrorHealthText"
                                           Text="None"
                                           TextWrapping="Wrap"
                                           MaxHeight="48"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="SEARCH">
                <Grid Margin="8,16,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="110"
                                    Height="40"
                                    Margin="10,0,0,0"
                                    Click="Search_Click"
                                    Content="Search" />
                            <ComboBox x:Name="SearchZoneSelector"
                                      DockPanel.Dock="Right"
                                      Width="220"
                                      Height="40"
                                      Margin="10,0,0,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="SearchZoneSelector_SelectionChanged"
                                      ToolTip="Limit search results to an observed zone" />
                            <TextBox x:Name="SearchBox"
                                     Height="40"
                                     FontSize="14"
                                     ToolTip="Search item, creature, object or ID"
                                     KeyDown="SearchBox_KeyDown" />
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="SearchStatusText"
                               Grid.Row="1"
                               Margin="4,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Type an item or source name and press Search." />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="RESULTS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="4,2,4,10" />
                                <Button x:Name="LoadMoreZoneResultsButton"
                                        DockPanel.Dock="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="4,10,4,4"
                                        Height="36"
                                        Visibility="Collapsed"
                                        Click="LoadMoreZoneResultsButton_Click"
                                        Content="Load 50 more"
                                        ToolTip="Browse the next page of already observed items and sources in this zone" />
                                <ListBox x:Name="SearchResults"
                                         SelectionChanged="SearchResults_SelectionChanged" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BackButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="38"
                                            Height="30"
                                            IsEnabled="False"
                                            Click="BackButton_Click"
                                            Content="←"
                                            ToolTip="Back" />

                                    <Button x:Name="ForwardButton"
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="38"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            IsEnabled="False"
                                            Click="ForwardButton_Click"
                                            Content="→"
                                            ToolTip="Forward" />

                                    <TextBlock x:Name="BreadcrumbText"
                                               Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Search results" />
                                </Grid>

                                <TextBlock x:Name="DetailTitleText"
                                           Grid.Row="2"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="Select a result" />

                                <TextBlock x:Name="DetailSubtitleText"
                                           Grid.Row="3"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Item and source details will appear here." />

                                <TabControl x:Name="DetailTabs"
                                            Grid.Row="5" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="GUILDBOOK">
                <Grid Margin="8,16,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="GuildSelector"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="GuildSelector_SelectionChanged"
                                      ToolTip="Select a guild snapshot" />

                            <Grid Grid.Column="2">
                                <TextBox x:Name="GuildFilterBox"
                                         Height="38"
                                         VerticalContentAlignment="Center"
                                         TextChanged="GuildFilterBox_TextChanged"
                                         ToolTip="Filter by character, class, rank, zone or profession" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#667387"
                                           IsHitTestVisible="False"
                                           Text="Filter character, class, rank, zone or profession...">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GuildFilterBox}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ComboBox x:Name="GuildProfessionFilter"
                                      Grid.Column="4"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="GuildProfessionFilter_SelectionChanged"
                                      ToolTip="Filter by profession" />

                            <CheckBox x:Name="GuildOnlineOnlyCheck"
                                      Grid.Column="6"
                                      VerticalAlignment="Center"
                                      Checked="GuildOnlineOnlyCheck_Changed"
                                      Unchecked="GuildOnlineOnlyCheck_Changed"
                                      Content="Online only" />

                            <Button Grid.Column="8"
                                    Width="120"
                                    Height="38"
                                    Click="SyncNow_Click"
                                    Content="Refresh data" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="GuildbookTitleText"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Text="Guildbook" />
                                    <TextBlock x:Name="GuildbookStatusText"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Sync a schema 9 addon snapshot to load guild data." />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border MinWidth="74"
                                            Margin="0,0,6,0"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="GuildbookMembersText"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="0" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="Members" />
                                        </StackPanel>
                                    </Border>

                                    <Border MinWidth="68"
                                            Margin="0,0,6,0"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="#162A24"
                                            BorderBrush="#2F6D58"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="GuildbookOnlineText"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="0" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="Online" />
                                        </StackPanel>
                                    </Border>

                                    <Border MinWidth="68"
                                            Margin="0,0,6,0"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="GuildbookOfflineText"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="0" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="Offline" />
                                        </StackPanel>
                                    </Border>

                                    <Border MinWidth="72"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="#705A2B"
                                            BorderThickness="1"
                                            ToolTip="Addon-side Guildbook refresh interval while logged in">
                                        <StackPanel>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="30m" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       Text="Refresh" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="GuildMembersGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      ColumnHeaderHeight="32"
                                      SelectionMode="Single">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow"
                                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="MinHeight" Value="32" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Character"
                                                        Binding="{Binding Name}"
                                                        Width="175" />
                                    <DataGridTemplateColumn Header="Class"
                                                            Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{Binding ClassBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ClassName}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Lvl"
                                                        Binding="{Binding Level}"
                                                        Width="52" />
                                    <DataGridTextColumn Header="Rank"
                                                        Binding="{Binding RankName}"
                                                        Width="115" />
                                    <DataGridTemplateColumn Header="Status"
                                                            Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Status}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Zone"
                                                        Binding="{Binding Zone}"
                                                        Width="145" />
                                    <DataGridTemplateColumn Header="Professions"
                                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding ProfessionChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,1,5,1"
                                                                    Padding="7,3"
                                                                    CornerRadius="9"
                                                                    Background="{Binding BackgroundBrush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Foreground="{Binding ForegroundBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Display}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ACCOUNT">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8,16,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}"
                                Padding="22"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Account"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="One ForeverDB sign-in, shared with the website"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,4,0,18" />

                                <TextBlock x:Name="AccountHeadlineText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="Not signed in" />
                                <TextBlock x:Name="AccountDetailText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="AccountEnvironmentText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="AccountMessageText"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Visibility="Collapsed" />

                                <StackPanel x:Name="DevicePanel"
                                            Margin="0,14,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="DeviceHeadlineText"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DeviceDetailText"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <Button x:Name="DeviceRetryButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="34"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="14,0"
                                            Click="DeviceRetry_Click"
                                            Content="Retry activation"
                                            Visibility="Collapsed" />
                                </StackPanel>

                                <StackPanel x:Name="AccountChoicePanel"
                                            Margin="0,18,0,0">
                                    <Button x:Name="AccountShowSignInButton"
                                            Height="38"
                                            Click="AccountShowSignIn_Click"
                                            Content="Sign in to a ForeverDB account" />
                                    <Button x:Name="AccountUseAnonymousButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="38"
                                            Margin="0,10,0,0"
                                            Click="AccountUseAnonymous_Click"
                                            Content="Use ForeverDB anonymously" />
                                </StackPanel>

                                <StackPanel x:Name="AccountSignInPanel"
                                            Margin="0,18,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Email"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="AccountEmailBox"
                                             Margin="0,6,0,12"
                                             MaxLength="254" />
                                    <TextBlock Text="Password"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <PasswordBox x:Name="AccountPasswordBox"
                                                 Margin="0,6,0,14"
                                                 MaxLength="256"
                                                 Padding="10,7"
                                                 Background="{StaticResource SurfaceAltBrush}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 KeyDown="AccountPasswordBox_KeyDown" />
                                    <Button x:Name="AccountSignInButton"
                                            Height="38"
                                            Click="AccountSignIn_Click"
                                            Content="Sign in" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                        <Button x:Name="AccountRegisterLinkButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"
                                                Click="AccountRegisterLink_Click"
                                                Content="Create an account (website)" />
                                        <Button x:Name="AccountForgotLinkButton"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"
                                                Margin="8,0,0,0"
                                                Click="AccountForgotLink_Click"
                                                Content="Forgot password" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="AccountSignedInPanel"
                                            Margin="0,18,0,0"
                                            Visibility="Collapsed">
                                    <Button x:Name="AccountSignOutButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="38"
                                            Click="AccountSignOut_Click"
                                            Content="Sign out of this computer" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Text="Signing out here does not sign you out of the website." />
                                </StackPanel>

                                <StackPanel x:Name="AccountLostPanel"
                                            Margin="0,18,0,0"
                                            Visibility="Collapsed">
                                    <Button x:Name="AccountReplaceAnonymousButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="38"
                                            Click="AccountReplaceAnonymous_Click"
                                            Content="Start a new anonymous identity…" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Text="Installations owned by the lost identity will not be able to sync from this computer." />
                                </StackPanel>

                                <StackPanel x:Name="AccountLegacyPanel"
                                            Margin="0,22,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Preserved anonymous identity"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="AccountLegacyText"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,8"
                                               Text="This computer's original anonymous identity is kept so its installations keep syncing." />
                                    <Button x:Name="AccountForgetLegacyButton"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="34"
                                            Click="AccountForgetLegacy_Click"
                                            Content="Forget anonymous identity…" />
                                </StackPanel>

                                <StackPanel x:Name="AccountPendingPanel"
                                            Margin="0,22,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Sign-out not confirmed"
                                               FontWeight="SemiBold" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,8"
                                               Text="The server could not confirm the previous sign-out. It is retried automatically." />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"
                                                Click="AccountRetryRevocation_Click"
                                                Content="Retry now" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,6"
                                                Margin="8,0,0,0"
                                                Click="AccountDiscardRevocation_Click"
                                                Content="Stop retrying…" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Installations on this computer"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Who may sync each installation, as confirmed by the server"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,14" />
                                    <TextBlock x:Name="AccountInstallationsEmptyText"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="No installation found yet. Run Sync now on the Status tab after /reload in game." />
                                    <ItemsControl x:Name="AccountInstallationsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding InstallationId}"
                                                                   FontFamily="Consolas"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding OwnershipText}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Visibility="{Binding DetailVisibility}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="12,5"
                                                                    Click="InstallationClaim_Click"
                                                                    Visibility="{Binding ClaimVisibility}"
                                                                    Content="{Binding ClaimActionText}" />
                                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="12,5"
                                                                    Margin="8,0,0,0"
                                                                    Click="InstallationCheck_Click"
                                                                    Visibility="{Binding CheckVisibility}"
                                                                    Content="Check status" />
                                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="12,5"
                                                                    Margin="8,0,0,0"
                                                                    Click="InstallationChooseAccount_Click"
                                                                    Visibility="{Binding ChooseAccountVisibility}"
                                                                    Content="Sync with my account" />
                                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="12,5"
                                                                    Margin="8,0,0,0"
                                                                    Click="InstallationChooseAnonymous_Click"
                                                                    Visibility="{Binding ChooseAnonymousVisibility}"
                                                                    Content="Sync anonymously" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AccountClaimCard"
                                    Style="{StaticResource CardStyle}"
                                    Padding="22"
                                    Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Link code"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="AccountClaimInstallationText"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontFamily="Consolas"
                                               Margin="0,4,0,12"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,12">
                                        <TextBlock x:Name="AccountClaimCodeText"
                                                   FontFamily="Consolas"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="AccountClaimCountdownText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Text="The code works once and for 10 minutes. Keep it private: anyone who has it and a ForeverDB account could take over this installation. Requesting a new code cancels this one. The website step that redeems the code arrives in a later update; nothing is linked until the server confirms it." />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,12,0,0">
                                        <Button Padding="14,7"
                                                Click="AccountCopyClaim_Click"
                                                Content="Copy code" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="14,7"
                                                Margin="8,0,0,0"
                                                Click="AccountDismissClaim_Click"
                                                Content="Hide code" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SETTINGS">
                <Grid Margin="8,16,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="General"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Startup and automatic synchronization"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,20" />

                            <CheckBox x:Name="AutoSyncCheck"
                                      Margin="0,5"
                                      Content="Automatically sync after /reload, logout or exit" />

                            <CheckBox x:Name="LaunchWithWindowsCheck"
                                      Margin="0,8,0,5"
                                      Content="Launch ForeverDB Companion with Windows" />

                            <CheckBox x:Name="StartMinimizedCheck"
                                      Margin="0,8,0,18"
                                      Content="Start minimized when launched with Windows" />

                            <Button Width="140"
                                    HorizontalAlignment="Left"
                                    Click="SaveSettings_Click"
                                    Content="Save settings" />

                            <TextBlock x:Name="SettingsSaveStatusText"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       Text="Settings saved."
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="Connection"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Detected game path and ForeverDB backend"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,20" />

                            <TextBlock Text="WoW Forever root"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="WowRootBox"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Supabase project URL"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="SupabaseUrlBox"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Supabase publishable key"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="SupabaseKeyBox"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
