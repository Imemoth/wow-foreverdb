    "publish:dry-run": "tsx src/cli.ts publish --dry-run",
    "build-projection": "tsx src/cli.ts build"
  },
  "dependencies": {
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
