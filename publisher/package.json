{
  "name": "foreverdb-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "One-way, fail-closed publication worker: private aggregate export -> sanitized public read model.",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "typecheck": "tsc --noEmit",
