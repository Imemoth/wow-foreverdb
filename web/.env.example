# ForeverDB web — environment template. NEVER commit real values.
# Public browsing adapters must NEVER receive a private Supabase database URL, service_role key
# or publication-worker credential. Only the separately approved server-side Account Auth/RPC
# boundary may use the existing private project's HTTPS URL with a publishable key.
# SUPABASE*, *SERVICE_ROLE*, DATABASE_URL or POSTGRES_URL* names remain REJECTED on hosted deployments.

# local | preview | production
#   local       developer machine only (the default off-Vercel; REJECTED on any hosted deployment)
#   preview     hosted, protected, noindex. Required value for the Vercel preview environment AND for the
#               temporary synthetic demonstration served through the Vercel production alias.
#   production  the real release. Never set until docs/web/go-live-checklist.md sections A-C are all done.
# On Vercel this variable is REQUIRED (no default). See docs/web/vercel-environments.md.
FOREVERDB_DEPLOYMENT=local
# fixture (labeled synthetic sample data) | postgres (isolated PUBLIC read DB). Required explicitly on hosted deployments.
FOREVERDB_DATA_SOURCE=fixture
# Least-privilege role only: postgresql://foreverdb_web_reader[.<ref>]:<password>@<public-db-host>:6543/postgres
AZERDEX_READ_DB_URL=
# Hosted preview: leave unset (derived from Vercel). Production: explicit https URL equal to the Vercel production domain.
SITE_URL=http://localhost:3000

# Distributed rate limiting (required in production)
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# >= 32 random bytes; keys the IP hash
RATE_LIMIT_SALT=
# x-real-ip on Vercel; cf-connecting-ip behind Cloudflare; none locally
TRUSTED_IP_HEADER=none
# Optional JSON override of DEFAULT_RULES in src/lib/security/rate-limit.ts
RATE_LIMITS_JSON=

# Optional progressive challenge (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CHALLENGE_COOKIE_SECRET=

# Account System V1 (server-only Auth/RPC boundary) — DISABLED by default.
# Do not populate any of the ACCOUNT_AUTH_* / ACCOUNT_CSRF_* variables while mode is disabled:
# the boot validator deliberately rejects partial/stray configurations.
#
# Local: localhost-only, isolated Supabase local stack.
# Staging: isolated Supabase project, protected Vercel Preview only.
# Pilot: existing private Supabase project, protected Vercel Preview (not production alias).
# Production: existing private Supabase project, only on real public ForeverDB production.
#
# Pilot and production have SEPARATE compile-time authorization flags, BOTH FALSE as shipped.
# Changing ACCOUNT_AUTH_MODE in Vercel does not grant owner approval or flip these flags.
# Even once separately approved, HTTPS, publishable key, same exact project ref, CSRF secret,
# Upstash, server-side Turnstile and site/deployment gates are mandatory. Production
# ALSO needs a separate PUBLIC read database (never the private Supabase instance).
# See docs/account-v1/single-project-candidate.md before ANY live setting change.
#
# ACCOUNT_AUTH_MODE=local
# ACCOUNT_AUTH_URL=http://127.0.0.1:54321
# ACCOUNT_AUTH_PROJECT_REF=          # staging/pilot/production only; exact Auth URL project ref
# ACCOUNT_AUTH_PUBLISHABLE_KEY=      # sb_publishable_ key only in pilot/production; never secret/service role
# ACCOUNT_CSRF_SECRET=               # generated >=32 chars, server-side only

# Class Guides talent icons (optional, OFF by default). Blizzard icons are never committed; they can only be served from the
# allow-listed asset host (NEXT_PUBLIC_AZERDEX_ASSET_BASE_URL) under talent-icons/<build>/<fileDataId>.webp. Owner decision;
# see docs/web/class-guides-talents.md. Anything other than "cdn" keeps icons off and the CSP unchanged.
# AZERDEX_TALENT_ICONS=cdn

# Class Guides talent description text is Blizzard game text: shown on beta/preview/local, withheld on a production
# deployment unless this is "1" (owner decision; see docs/web/class-guides-talents.md).
# AZERDEX_TALENT_TEXT=1

# Vercel Speed Insights is OFF unless this is "1" (the browser then never requests it). It only decides whether the script is
# rendered; it does not change the Vercel plan. The free tier gives a Real Experience Score only (10,000 events per rolling 30
# days, team-wide); LCP/INP/CLS breakdowns need Speed Insights Plus, which is billed. See docs/web/vercel-speed-insights.md.
# AZERDEX_SPEED_INSIGHTS=1
