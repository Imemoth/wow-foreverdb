# ForeverDB web — environment template. NEVER commit real values.
# The website must never receive production Supabase URLs, service_role keys
# or the publication worker's credentials. Any SUPABASE*, *SERVICE_ROLE*, DATABASE_URL or POSTGRES_URL*
# variable is REJECTED on hosted deployments.

# local | preview | production
#   local       developer machine only (the default off-Vercel; REJECTED on any hosted deployment)
#   preview     hosted, protected, noindex. Required value for the Vercel preview environment AND for the
#               temporary synthetic demonstration served through the Vercel production alias.
#   production  the real release. Never set until docs/web/go-live-checklist.md sections A-C are all done.
# On Vercel this variable is REQUIRED (no default). See docs/web/vercel-environments.md.
FOREVERDB_DEPLOYMENT=local
# fixture (labeled synthetic sample data) | postgres (isolated PUBLIC read DB). Required explicitly on hosted deployments.
FOREVERDB_DATA_SOURCE=fixture
# Least-privilege role only: postgresql://foreverdb_web_reader[.<ref>]:<password>@<public-db-host>:6543/postgres
PUBLIC_READ_DATABASE_URL=
# Hosted preview: leave unset (derived from Vercel). Production: explicit https URL equal to the Vercel production domain.
SITE_URL=http://localhost:3000

# Distributed rate limiting (required in production)
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# >= 32 random bytes; keys the IP hash
RATE_LIMIT_SALT=
# x-real-ip on Vercel; cf-connecting-ip behind Cloudflare; none locally
TRUSTED_IP_HEADER=none
# Optional JSON override of DEFAULT_RULES in src/lib/security/rate-limit.ts
RATE_LIMITS_JSON=

# Optional progressive challenge (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CHALLENGE_COOKIE_SECRET=
